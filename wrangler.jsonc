{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terraoi-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "terraoi-web" },
    // T-211 PR-3b / #170: app Worker is the only config that declares this binding.
    // Targets named WorkerEntrypoint RPC `mintObjectUrl` on terraoi-extraction — not fetch.
    {
      "binding": "OBJECT_URL_MINT",
      "service": "terraoi-extraction",
      "entrypoint": "ObjectUrlMint"
    }
  ],
  // workers.dev and preview URLs must not become a tenant entry point (plan §4.1).
  "workers_dev": false,
  "preview_urls": false,
  // T-130 pilot inquiry (ADR-0002): 3 requests per 60 s per IP hash. TURNSTILE_SECRET and
  // INQUIRY_IP_HMAC_KEY are secrets (wrangler secret put); the INQUIRY_DB Hyperdrive binding is
  // added to env.staging by the owner (T-130 human step 3).
  // T-102h / #75: SESSION_DB Hyperdrive (login user IN ROLE toi_session_worker) and
  // SESSION_TOKEN_KEY / IDENTITY_SESSION_KEY secrets are owner steps on T-004 — bind them under
  // env.staging only; never put connection strings or key material in this file.
  // T-211 PR-3a / ADR-0005 §9: JOB_DB Hyperdrive (login user IN ROLE toi_job_api) is the same
  // owner step — bind under env.staging only; the app Worker uses it for /api/jobs/* and never
  // for table grants. PR-3b: OBJECT_URL_MINT → workers/ ObjectUrlMint (service-role stays there).
  "ratelimits": [{ "name": "INQUIRY_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  "vars": { "TURNSTILE_SITE_KEY": "" },
  // Routes (e.g. "*.terraoi.app/*") are added in T-004 after DNS is verified (human-only, plan §20.8).
  "env": {
    "staging": {
      "name": "terraoi-web-staging",
      "workers_dev": false,
      "preview_urls": false,
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "terraoi-web-staging" },
        {
          "binding": "OBJECT_URL_MINT",
          "service": "terraoi-extraction-staging",
          "entrypoint": "ObjectUrlMint"
        }
      ],
      "ratelimits": [{ "name": "INQUIRY_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }],
      "vars": { "TURNSTILE_SITE_KEY": "" },
      // T-004: exact staging hosts only, each with a proxied DNS record (AAAA 100::) in the
      // terraoi.app zone. No wildcard: a later production `*.terraoi.app/*` route must not be
      // shadowed, and Cloudflare prefers these more specific patterns over it. Add a staging
      // tenant here and in DNS together. Never reference production resources in env.staging.
      "routes": [
        { "pattern": "staging.terraoi.app/*", "zone_name": "terraoi.app" },
        { "pattern": "company1-staging.terraoi.app/*", "zone_name": "terraoi.app" },
        { "pattern": "company2-staging.terraoi.app/*", "zone_name": "terraoi.app" }
      ]
    },
    // T-404 (plan §17.2) prepared this block; it is a *shape*, not a deploy path. There is no
    // production job in `.github/workflows/` — the packet proposes one for the supervisor to land —
    // and every value in angle brackets is created by the owner on T-004 (plan §20.8: production
    // project, Hyperdrive configs, DNS, routes, TLS, secrets). Nothing here is a secret or a real
    // resource id: these are binding NAMES and placeholders, per AGENTS §4.6.
    "production": {
      "name": "terraoi-web",
      "workers_dev": false,
      "preview_urls": false,
      // The same binding names the staging block uses, and repeated here for the reason the staging
      // comment above gives: wrangler replaces arrays rather than merging them, so an inherited
      // staging value would be the bug. scripts/check-release-preflight.mjs refuses this block if it
      // ever points at a staging Worker, a staging host, or a secret-shaped value.
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "terraoi-web" }],
      "ratelimits": [
        { "name": "INQUIRY_RATE_LIMITER", "namespace_id": "<PROD_INQUIRY_RATE_LIMIT_NS>", "simple": { "limit": 3, "period": 60 } }
      ],
      // Bindings the owner creates before traffic (T-004). Wrangler 4 Hyperdrive entries are
      // binding + id only (no connection-string fields in this file — AGENTS §4.6). SESSION_DB and
      // INQUIRY_DB are what code on main reads today; CONFIG_DB (T-116) and JOB_DB (T-211) are the
      // server-path bindings the packet checklist names for the owner. Secrets use
      // `wrangler secret put` (SESSION_TOKEN_KEY, IDENTITY_SESSION_KEY, TURNSTILE_SECRET,
      // INQUIRY_IP_HMAC_KEY, the email API key, the model key) — never as a value here.
      "hyperdrive": [
        { "binding": "SESSION_DB", "id": "<PROD_SESSION_DB_HYPERDRIVE_ID>" },
        { "binding": "CONFIG_DB", "id": "<PROD_CONFIG_DB_HYPERDRIVE_ID>" },
        { "binding": "JOB_DB", "id": "<PROD_JOB_DB_HYPERDRIVE_ID>" },
        { "binding": "INQUIRY_DB", "id": "<PROD_INQUIRY_DB_HYPERDRIVE_ID>" }
      ],
      "vars": { "TURNSTILE_SITE_KEY": "" },
      // Deliberately empty, and the emptiness is the guard: plan §4.1 wants exact production hosts, and
      // T-004 adds them only after DNS and TLS are verified. A production deploy with no routes would
      // serve nothing on the tenant hosts yet still report success, so check-release-preflight refuses
      // production until these lines exist. Whether to also add a `*.terraoi.app/*` wildcard is the
      // owner's decision — the note above explains why the exact staging patterns have to be listed
      // alongside it, and a wildcard does not make an unverified host resolvable.
      "routes": []
    }
  }
}
