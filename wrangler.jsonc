{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terraoi-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "terraoi-web" }],
  // workers.dev and preview URLs must not become a tenant entry point (plan §4.1).
  "workers_dev": false,
  "preview_urls": false,
  // T-130 pilot inquiry (ADR-0002): 3 requests per 60 s per IP hash. TURNSTILE_SECRET and
  // INQUIRY_IP_HMAC_KEY are secrets (wrangler secret put); the INQUIRY_DB Hyperdrive binding is
  // added to env.staging by the owner (T-130 human step 3).
  // T-102h / #75: SESSION_DB Hyperdrive (login user IN ROLE toi_session_worker) and
  // SESSION_TOKEN_KEY / IDENTITY_SESSION_KEY secrets are owner steps on T-004 — bind them under
  // env.staging only; never put connection strings or key material in this file.
  "ratelimits": [{ "name": "INQUIRY_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  "vars": { "TURNSTILE_SITE_KEY": "" },
  // Routes (e.g. "*.terraoi.app/*") are added in T-004 after DNS is verified (human-only, plan §20.8).
  "env": {
    "staging": {
      "name": "terraoi-web-staging",
      "workers_dev": false,
      "preview_urls": false,
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "terraoi-web-staging" }],
      "ratelimits": [{ "name": "INQUIRY_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }],
      "vars": { "TURNSTILE_SITE_KEY": "" },
      // T-004: exact staging hosts only, each with a proxied DNS record (AAAA 100::) in the
      // terraoi.app zone. No wildcard: a later production `*.terraoi.app/*` route must not be
      // shadowed, and Cloudflare prefers these more specific patterns over it. Add a staging
      // tenant here and in DNS together. Never reference production resources in env.staging.
      "routes": [
        { "pattern": "staging.terraoi.app/*", "zone_name": "terraoi.app" },
        { "pattern": "company1-staging.terraoi.app/*", "zone_name": "terraoi.app" },
        { "pattern": "company2-staging.terraoi.app/*", "zone_name": "terraoi.app" }
      ]
    }
  }
}
