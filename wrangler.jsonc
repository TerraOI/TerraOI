{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terraoi-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "terraoi-web" }],
  // workers.dev and preview URLs must not become a tenant entry point (plan §4.1).
  "workers_dev": false,
  "preview_urls": false,
  // T-130 pilot inquiry (ADR-0002): 3 requests per 60 s per IP hash. TURNSTILE_SECRET and
  // INQUIRY_IP_HMAC_KEY are secrets (wrangler secret put); the INQUIRY_DB Hyperdrive binding is
  // added to env.staging by the owner (T-130 human step 3).
  "ratelimits": [{ "name": "INQUIRY_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  "vars": { "TURNSTILE_SITE_KEY": "" },
  // Routes (e.g. "*.terraoi.app/*") are added in T-004 after DNS is verified (human-only, plan §20.8).
  "env": {
    "staging": {
      "name": "terraoi-web-staging",
      "workers_dev": false,
      "preview_urls": false,
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "terraoi-web-staging" }],
      "ratelimits": [{ "name": "INQUIRY_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }],
      "vars": { "TURNSTILE_SITE_KEY": "" }
      // Staging routes, vars and secrets: T-004. Never reference production resources here.
    }
  }
}
